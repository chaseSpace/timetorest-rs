{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LeafShield",
  "version": "0.6.1",
  "identifier": "com.leafshield.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "一叶 · LeafShield",
        "width": 620,
        "height": 390,
        "minWidth": 600,
        "minHeight": 380,
        "center": true,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#e9f3fc"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "一叶，让休息自然发生",
    "category": "HealthcareAndFitness",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}
